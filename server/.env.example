# football-data.org v4 — plan gratis
# Registrate en https://www.football-data.org/client/register
# La key se mete como variable de entorno, NUNCA en el repo.
FOOTBALL_DATA_TOKEN=

# Puertos
PORT=8787

# Temporadas a usar para calcular los ratings del modelo (historial).
# Cuantas mas temporadas, mas estable el rating. La gratis da la actual y la anterior.
SEASONS=2024,2025

# Competiciones de football-data.org que interesan.
LEAGUES=PL,PD,SA,BL1,FL1,MX